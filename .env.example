# Copy to .env and fill in. Never commit .env.

# Optional but recommended: raises Socrata rate limits substantially.
# Get one free at https://data.cityofnewyork.us/profile/edit/developer_settings
SOCRATA_APP_TOKEN=

# Local DuckDB warehouse location.
MIP_DUCKDB_PATH=data/warehouse/mip.duckdb

# Default cap on records fetched per source per run (dev sample size).
# Raise this to scale up the local dataset.
MIP_MAX_RECORDS=50000

# Records fetched per API request (Socrata 2.1 allows up to 50000).
MIP_PAGE_SIZE=10000

# --- analytics stack (local defaults; override for anything shared) ---
PG_HOST=localhost
PG_PORT=5433
PG_DB=mip
PG_USER=mip
PG_PASSWORD=mip_local_dev
METABASE_URL=http://localhost:3000
METABASE_ADMIN_EMAIL=admin@mip.local
METABASE_ADMIN_PASSWORD=MipLocal-Dev1
AIRFLOW_ADMIN_PASSWORD=mip_local_dev
